generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  tier        PlanTier     @default(FREE)
  price       Float
  maxProducts Int          @default(10)
  maxOrders   Int          @default(100)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  restaurants Restaurant[]

  @@map("plans")
}

model Restaurant {
  id                 Int        @id @default(autoincrement())
  name               String
  corporateName      String?
  cnpj               String?    @unique
  slug               String     @unique
  logo               String?
  description        String?
  phone              String?
  isActive           Boolean    @default(true)
  provisioningStatus String     @default("PENDING")
  databaseName       String?
  planId             Int?
  subscriptionStatus String     @default("active")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  categories         Category[]
  customers          Customer[]
  orders             Order[]
  products           Product[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  plan               Plan?      @relation(fields: [planId], references: [id])
  settings           Settings?
  users              User[]
  provisioningLogs   ProvisioningLog[]
  printDevices       PrintDevice[]
  printJobs          PrintJob[]
  
  // PIX Configuration for Dynamic QR Codes
  pixKey             String?
  pixKeyType         String?    // 'cpf' | 'cnpj' | 'email' | 'phone' | 'random'
  whatsappNumber     String?
  pixInstructions    String?

  @@map("restaurants")
}

model ProvisioningLog {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  message      String
  level        String   @default("info")
  createdAt    DateTime @default(now())

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model User {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  password     String
  role         UserRole    @default(OWNER)
  isApproved   Boolean     @default(false)
  isActive     Boolean     @default(true)
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt DateTime?
  emailNotificationsEnabled Boolean @default(true)
  sessionVersion Int @default(0)
  restaurantId Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]
  openedCashSessions CashSession[] @relation("CashSessionOpenedBy")
  closedCashSessions CashSession[] @relation("CashSessionClosedBy")
  cashMovements CashMovement[] @relation("CashMovementCreatedBy")
  voidedCashMovements CashMovement[] @relation("CashMovementVoidedBy")
  passwordChangeAttempts PasswordChangeAttempt[]
  passwordResetTokens PasswordResetToken[]
  requestedPrintJobs PrintJob[] @relation("PrintJobRequestedBy")

  @@index([restaurantId])
  @@index([emailVerificationTokenHash])
  @@map("users")
}

model Customer {
  id           Int        @id @default(autoincrement())
  name         String
  phone        String?
  email        String?
  restaurantId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  accessCredential CustomerAccessCredential?

  @@index([restaurantId])
  @@map("customers")
}

model CustomerAccessCredential {
  id           Int      @id @default(autoincrement())
  customerId   Int      @unique
  restaurantId Int
  tokenHash    String
  validFrom    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([restaurantId, tokenHash])
  @@map("customer_access_credentials")
}

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  slug         String
  order        Int        @default(0)
  isActive     Boolean    @default(true)
  restaurantId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  typeMontagem String?    @default("padrao")
  guidedAssemblyConfig Json?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([restaurantId, slug])
  @@unique([id, restaurantId])
  @@index([restaurantId])
  @@map("categories")
}

model Product {
  id           Int         @id @default(autoincrement())
  name         String
  description  String?
  price        Float
  image        String?
  isActive     Boolean     @default(true)
  isFeatured   Boolean     @default(false)
  discountPercent Float    @default(0)
  stockQuantity Int        @default(0)
  trackStock   Boolean     @default(false)
  restaurantId Int
  categoryId   Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  addons       Json?
  ingredients  Json?
  sizes        Json?
  usesGuidedAssembly Boolean @default(false)
  guidedAssemblyConfig Json?
  orderItems   OrderItem[]
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([id, restaurantId])
  @@index([restaurantId])
  @@index([categoryId])
  @@map("products")
}

model Order {
  id            Int           @id @default(autoincrement())
  idempotencyKey String?
  customerName  String
  phone         String?
  address       Json?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod?
  subtotal      Float
  deliveryFee   Float         @default(0)
  total         Float
  notes         String?
  tableNumber   Int?
  restaurantId  Int
  customerId    Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  changeFor     String?
  cpf           String?
  items         OrderItem[]
  customer      Customer?     @relation(fields: [customerId], references: [id])
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cashSessionId Int?
  
  // PIX Payment Fields
  pixProofUrl    String?
  pixProofAt     DateTime?
  pixConfirmedAt DateTime?
  pixConfirmedBy String?

  @@index([restaurantId])
  @@index([customerId])
  @@index([cashSessionId])
  @@unique([restaurantId, idempotencyKey])
  @@map("orders")
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  productId    Int
  quantity     Int
  price        Float
  createdAt    DateTime @default(now())
  addons       Json?
  name         String?
  observations String?
  removals     Json?
  variation    String?
  guidedAssemblySelections Json?
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Settings {
  id             Int        @id @default(autoincrement())
  restaurantId   Int        @unique
  storeName      String
  bio            String?
  phone          String?
  address        String?
  bannerBadge    String?
  bannerTitleLine1 String?
  bannerTitleLine2 String?
  bannerDescription String?
  bannerCtaLabel String?
  bannerImage    String?
  deliveryFee    Float      @default(5)
  minOrderValue  Float      @default(20)
  cashDifferenceNoteThreshold Float @default(5)
  deliveryEtaMinutes Int    @default(35)
  tableCount     Int        @default(0)
  isOpen         Boolean    @default(true)
  primaryColor   String     @default("#ef4444")
  logo           String?
  instagram      String?
  facebook       String?
  operatingHours Json?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deliveryRadius Float?     @default(5)
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  // PIX - chave do lojista para receber pagamentos (credenciais Efi são centralizadas)
  pixEnabled     Boolean   @default(false)
  pixKey         String?   // chave PIX do lojista (CPF, CNPJ, email, celular ou aleatória)

  @@map("settings")
}

model CashSession {
  id               Int               @id @default(autoincrement())
  restaurantId     Int
  openedById       Int?
  closedById       Int?
  openingAmount    Float             @default(0)
  closingAmount    Float?
  expectedAmount   Float?
  differenceAmount Float?
  informedCardAmount Float?            @default(0)
  informedPixAmount  Float?            @default(0)
  cashCountBreakdown Json?
  status           CashSessionStatus @default(OPEN)
  notes            String?
  openedAt         DateTime          @default(now())
  closedAt         DateTime?
  countFromDate    DateTime?         // quando definido, queries financeiras partem deste timestamp ao invés de openedAt
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  openedBy         User?             @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy         User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  movements        CashMovement[]

  @@index([restaurantId, status])
  @@index([openedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id           Int              @id @default(autoincrement())
  cashSessionId Int
  restaurantId Int
  createdById  Int?
  type         CashMovementType
  amount       Float
  reason       String?
  notes        String?
  createdAt    DateTime         @default(now())
  voidedAt     DateTime?
  voidedById   Int?
  voidReason   String?
  cashSession  CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("CashMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy     User?            @relation("CashMovementVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([cashSessionId, createdAt])
  @@index([cashSessionId, voidedAt])
  @@index([restaurantId, type])
  @@map("cash_movements")
}

enum PlanTier {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  CASHIER
  EMPLOYEE
}

enum OrderStatus {
  PENDING
  OPEN
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  RETIRED
  CANCELLED
  REFUNDED
  PAID
}

enum PaymentMethod {
  PIX
  CASH
  CARD
  DEBIT
  CREDIT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SUPPLY
  WITHDRAWAL
  ADJUSTMENT
}

enum PrintConnectionType {
  NETWORK
  USB
}

enum PrintTemplate {
  ORDER_TICKET
  CASH_CLOSING_REPORT
  TEST_TICKET
}

enum PrintMode {
  THERMAL
  A4
}

enum PrintJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?
  actorEmail  String?
  action      String
  subjectType String
  subjectId   Int?
  details     Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt])
  @@index([subjectType, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model PasswordChangeAttempt {
  id           Int      @id @default(autoincrement())
  userId       Int
  success      Boolean  @default(false)
  reason       String?  // "Invalid current password", "Weak password", etc
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("password_change_attempts")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  email     String   // Cópia do email para rastreamento
  token     String   @unique // Token criptografado/hash
  used      Boolean  @default(false)
  usedAt    DateTime?
  expiresAt DateTime // Válido por 1 hora
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PrintDevice {
  id              Int                 @id @default(autoincrement())
  restaurantId    Int
  name            String
  agentToken      String              @unique
  connectionType  PrintConnectionType @default(NETWORK)
  ipAddress       String?
  port            Int?                @default(9100)
  usbVendorId     String?
  usbProductId    String?
  paperWidthMm    Int                 @default(80)
  isActive        Boolean             @default(true)
  autoPrintOrders Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  jobs            PrintJob[]

  @@index([restaurantId, isActive])
  @@map("print_devices")
}

model PrintJob {
  id            Int            @id @default(autoincrement())
  restaurantId  Int
  printerId     Int?
  requestedById Int?
  subjectType   String
  subjectId     Int?
  template      PrintTemplate
  printMode     PrintMode      @default(THERMAL)
  status        PrintJobStatus @default(PENDING)
  copies        Int            @default(1)
  payload       Json
  errorMessage  String?
  attempts      Int            @default(0)
  processedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  printer       PrintDevice?   @relation(fields: [printerId], references: [id], onDelete: SetNull)
  requestedBy   User?          @relation("PrintJobRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, createdAt])
  @@index([printerId, status, createdAt])
  @@index([subjectType, subjectId, createdAt])
  @@map("print_jobs")
}
