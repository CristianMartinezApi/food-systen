{
  "name": "food-system-api",
  "version": "1.1.0",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test \"tests/*.test.js\"",
    "build": "tsc",
    "test:hours": "node --test tests/hours.test.js",
    "test:cashier": "node --test tests/cashier.test.js",
    "test:seed": "node --test tests/superadmin-seed.test.js",
    "seed": "ts-node scripts/seed.ts",
    "migrate:dev": "prisma migrate dev --skip-generate",
    "migrate:prod": "prisma migrate deploy",
    "db:backup": "pg_dump -U $POSTGRES_USER -d $POSTGRES_DB > backup_$(date +%Y%m%d_%H%M%S).sql",
    "db:restore": "psql -U $POSTGRES_USER -d $POSTGRES_DB < backup.sql"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.70.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4",
    "resend": "^6.18.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  }
}
