# ===================================
# CONFIGURAÇÃO DE SEGURANÇA - FOOD SYSTEM
# ===================================
# ⚠️ NUNCA committar este arquivo
# ⚠️ Adicione .env ao .gitignore

# --- BACKEND CORE ---
PORT=8000
NODE_ENV=development

# --- DATABASE (ALTERE AS CREDENCIAIS!) ---
# Gerar senha: openssl rand -base64 20
DATABASE_URL=postgresql://app_user:GereSenhaForteLongo32Caracteres@localhost:5432/food_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=GereSenhaForteLongo32Caracteres
POSTGRES_DB=food_db

# --- JWT (Gerar com: openssl rand -base64 32) ---
JWT_SECRET=SeuSecretJWTAleatorio32CaracteresAqui

# --- FRONTEND ---
FRONTEND_URL=http://localhost:3000

# --- SECURITY - CORS ---
# Separar múltiplos origins com vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- ADMIN INICIAL (remova após primeira execução!) ---
# Use para criar o primeiro super admin
INITIAL_ADMIN_PASSWORD=GereUmaSenhaInicialForteAqui

# --- Email/Notificações (Resend) ---
RESEND_API_KEY=re_sua_chave
EMAIL_FROM=FoodSystem <noreply@seu-dominio-verificado.com>
FRONTEND_URL=http://localhost:3000

# --- Push Web (notificação de status de pedido ao cliente) ---
# Gerar o par com: npx web-push generate-vapid-keys
# Sem essas 3 variáveis, o sistema funciona normalmente e só não envia push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seu-dominio.com

# --- RATE LIMITING ---
# Máximo de requisições por IP por janela (15 min padrão)
RATE_LIMIT_MAX=100

# --- LOGS ---
LOG_LEVEL=info

# --- AUDITORIA ---
# Janela padrão de consulta da auditoria (em dias)
AUDIT_DEFAULT_DAYS=7
# Limite máximo de linhas por exportação CSV de auditoria
AUDIT_EXPORT_MAX_ROWS=5000
# Limite máximo de linhas por exportação assíncrona de auditoria
AUDIT_ASYNC_EXPORT_MAX_ROWS=20000
# Tamanho do lote por leitura durante a geração assíncrona do CSV
AUDIT_ASYNC_EXPORT_BATCH_SIZE=1000
# Tempo de vida do job assíncrono (em minutos)
AUDIT_EXPORT_JOB_TTL_MINUTES=30
# Quantidade máxima de jobs assíncronos ativos simultaneamente
AUDIT_EXPORT_MAX_CONCURRENT_JOBS=1
# Ativa limpeza automática de logs antigos
AUDIT_RETENTION_ENABLED=true
# Retenção de logs detalhados (em dias)
AUDIT_RETENTION_DAYS=180
# Intervalo da rotina de limpeza (em horas)
AUDIT_RETENTION_INTERVAL_HOURS=24
