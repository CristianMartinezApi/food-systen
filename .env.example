# ===================================
# FOOD SYSTEM - VARIÁVEIS DE AMBIENTE
# ===================================
# ⚠️ NUNCA committar este arquivo no Git!
# ⚠️ Adicione .env ao .gitignore

# --- BACKEND CORE ---
PORT=8000
NODE_ENV=development

# --- DATABASE (ALTERE AS CREDENCIAIS!) ---
# Gerar PASSWORD com: openssl rand -base64 20
DATABASE_URL=postgresql://app_user_dev:SenhaForteAleatoriaAqui123456@localhost:5432/food_db
POSTGRES_USER=app_user_dev
POSTGRES_PASSWORD=SenhaForteAleatoriaAqui123456
POSTGRES_DB=food_db

# --- JWT (Gerar com: openssl rand -base64 32) ---
# Exemplo: VhMWRzQmL0gJ2x1fXQw0dz5K8vL3pQ+rR9sY2uN5aB8=
JWT_SECRET=GereSeuSecretJWTAleatorio32CaracteresAquiUsandoOpenSSL

# --- FRONTEND URL ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# --- SECURITY - CORS ---
# Separar múltiplos origins com vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://seudominio.com

# --- SENHAS INICIAIS (USE APENAS NA PRIMEIRA EXECUÇÃO) ---
# Deixe em branco após primeira execução para gerar senhas aleatórias
INITIAL_ADMIN_PASSWORD=GereUmaSenhaInicialForteAqui
INITIAL_SUPERADMIN_PASSWORD=GereUmaSenhaInicialSuperAdminForteAqui

# --- RATE LIMITING ---
RATE_LIMIT_MAX=100

# --- LOGS ---
LOG_LEVEL=info

# --- AUDITORIA ---
# Janela padrão de consulta da auditoria (em dias)
AUDIT_DEFAULT_DAYS=7
# Limite máximo de linhas por exportação CSV de auditoria
AUDIT_EXPORT_MAX_ROWS=5000
# Limite máximo de linhas por exportação assíncrona de auditoria
AUDIT_ASYNC_EXPORT_MAX_ROWS=20000
# Tamanho do lote por leitura durante a geração assíncrona do CSV
AUDIT_ASYNC_EXPORT_BATCH_SIZE=1000
# Tempo de vida do job assíncrono (em minutos)
AUDIT_EXPORT_JOB_TTL_MINUTES=30
# Quantidade máxima de jobs assíncronos ativos simultaneamente
AUDIT_EXPORT_MAX_CONCURRENT_JOBS=1
# Ativa limpeza automática de logs antigos
AUDIT_RETENTION_ENABLED=true
# Retenção de logs detalhados (em dias)
AUDIT_RETENTION_DAYS=180
# Intervalo da rotina de limpeza (em horas)
AUDIT_RETENTION_INTERVAL_HOURS=24

# --- Email/Notificações (Resend) ---
# Obrigatório para confirmação de endereço e avisos operacionais.
RESEND_API_KEY=re_sua_chave
EMAIL_FROM=FoodSystem <noreply@seu-dominio-verificado.com>

# --- OPCIONAL: Analytics ---
# SENTRY_DSN=https://seu-sentry-dsn@sentry.io/project-id
